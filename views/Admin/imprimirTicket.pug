doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Ticket de Venta - #{venta.comprobanteId}
    style.
      body { font-family: 'Courier New', Courier, monospace; background-color: #f4f6f9; padding: 20px; display: flex; flex-direction: column; align-items: center; }
      .ticket { background-color: white; padding: 20px; width: 300px; border: 1px dashed #333; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
      .center { text-align: center; }
      hr { border-top: 1px dashed #333; border-bottom: none; }
      
      /* Botones de acción */
      .acciones { margin-top: 30px; display: flex; gap: 15px; }
      .btn { padding: 12px 20px; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; font-size: 16px; text-decoration: none; }
      .btn-imprimir { background-color: #0f766e; color: white; }
      .btn-volver { background-color: #64748b; color: white; }

      /* Ocultar botones a la hora de imprimir en papel */
      @media print {
        body { background-color: white; padding: 0; }
        .ticket { box-shadow: none; border: none; width: 100%; }
        .acciones { display: none; }
      }

  body
    //- EL TICKET
    div.ticket
      h2.center(style="margin-bottom: 5px;") SISTEMA DE VENTAS
      p.center(style="margin-top: 0; font-size: 12px;") Sucursal Principal
      hr
      p 
        strong Ticket #: 
        | #{venta.comprobanteId}
      p 
        strong Fecha: 
        | #{venta.fechaCompra.toLocaleString('es-AR')}
      p 
        strong Cajero: 
        | #{cajero}
      hr
      p 
        strong Cliente: 
        | #{venta.nombreCliente}
      hr
      
      each item in venta.items
        p(style="margin-bottom: 0;") 
          strong Evento: 
          | #{item.nombreEvento}
        p(style="margin: 0;") #{item.cantidad}x #{item.tipoEntrada} ($#{item.precio})
        
      hr
      h3(style="text-align: right;") TOTAL: $#{venta.total}
      p.center 
        strong Medio: 
        | #{venta.medioPago}
      hr
      p.center(style="font-size: 12px;") ¡Gracias por su compra!
      p.center(style="font-size: 12px;") Conservar este ticket para el ingreso.

    //- BOTONES DE ACCIÓN (Se ocultan al imprimir)
    div.acciones
      button.btn.btn-imprimir(onclick="window.print()") 🖨️ Imprimir Ticket
      a.btn.btn-volver(href="/admin/boleteria") ⬅️ Volver a la Boletería