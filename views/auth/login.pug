doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Iniciar Sesión
  body(style="font-family: sans-serif; max-width: 400px; margin: 40px auto;")
    h2 Iniciar Sesión
    
    if error
      div(style="background-color: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 15px; border-radius: 4px;")
        = error

    form(action="/auth/login" method="POST")
      div(style="margin-bottom: 10px;")
        label(for="identificador") Email o Nombre de Usuario:
        input#identificador(type="text" name="identificador" required style="width: 100%; padding: 6px;" placeholder="ej: admin o correo@email.com")
        
      div(style="margin-bottom: 15px;")
        label(for="password") Contraseña:
        input#password(type="password" name="password" required style="width: 100%; padding: 6px;")

      div
        button(type="submit" style="width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 4px;") Entrar

    p(style="margin-top: 15px;") ¿No tienes cuenta? 
      a(href="/auth/registro") Regístrate aquí