doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Registro de Cliente - Urbana Cult
  body(style="font-family: sans-serif; padding: 40px; max-width: 500px; margin: auto; background-color: #f4f6f9;")
    
    div(style="background-color: #ffffff; padding: 35px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);")
      div(style="text-align: center; margin-bottom: 25px;")
        h2(style="margin: 0; color: #2c3e50;") 🎭 Urbana Cult
        p(style="margin: 5px 0 0 0; color: #64748b; font-size: 14px;") Crea tu cuenta de cliente en segundos

      if error
        div(style="background: #fee2e2; color: #991b1b; padding: 12px; border-radius: 6px; margin-bottom: 20px; font-size: 13px; font-weight: bold;")= error

      form(action="/auth/registro" method="POST" style="display: flex; flex-direction: column; gap: 15px;")
        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") Nombre (Solo letras, máx. 15)
          input(type="text" name="nombre" value=(datos ? datos.nombre : '') placeholder="Ej. Juan" pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ\\s]+" maxlength="15" title="El nombre solo debe contener letras y máximo 15 caracteres" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;" oninput="this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ\\s]/g, '')")
        </div>

        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") Apellido (Solo letras, máx. 15)
          input(type="text" name="apellido" value=(datos ? datos.apellido : '') placeholder="Ej. Pérez" pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ\\s]+" maxlength="15" title="El apellido solo debe contener letras y máximo 15 caracteres" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;" oninput="this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ\\s]/g, '')")
        </div>

        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") DNI (7 u 8 dígitos numéricos)
          input(type="text" name="dni" value=(datos ? datos.dni : '') placeholder="Ej. 35123456" pattern="\\d{7,8}" maxlength="8" title="Ingrese entre 7 y 8 números" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;" oninput="this.value = this.value.replace(/[^0-9]/g, '')")
        </div>

        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") Correo Electrónico
          input(type="email" name="correo" value=(datos ? datos.correo : '') placeholder="correo@ejemplo.com" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;")
        </div>

        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") Fecha de Cumpleaños (+18 años)
          input(type="date" name="cumpleaños" value=(datos ? datos.cumpleaños : '') required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;")
        </div>

        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") Nombre de Usuario (Username, máx. 30)
          input(type="text" name="username" value=(datos ? datos.username : '') placeholder="juanperez" maxlength="30" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;")
        </div>

        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") Contraseña
          input(type="password" name="password" placeholder="••••••••" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;")
        </div>

        <button type="submit" style="background: #2563eb; color: white; border: none; padding: 12px; border-radius: 6px; font-weight: bold; font-size: 15px; cursor: pointer; margin-top: 10px; width: 100%;">Registrarse</button>
      </form>

      <div style="text-align: center; margin-top: 20px; font-size: 14px;">
        <span style="color: #64748b;">¿Ya tienes una cuenta? </span>
        <a href="/auth/login" style="color: #2563eb; text-decoration: none; font-weight: bold;">Iniciar Sesión</a>
      </div>
    </div>