doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Registro de Cliente - Urbana Cult
  body(style="font-family: sans-serif; padding: 40px; max-width: 500px; margin: auto; background-color: #f4f6f9;")
    
    div(style="background-color: #ffffff; padding: 35px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);")
      div(style="text-align: center; margin-bottom: 25px;")
        h2(style="margin: 0; color: #2c3e50;") 🎭 Urbana Cult
        p(style="margin: 5px 0 0 0; color: #64748b; font-size: 14px;") Crea tu cuenta de cliente en segundos

      div#mensajeAlerta(style="display: none; padding: 12px; border-radius: 6px; margin-bottom: 20px; font-size: 13px; font-weight: bold;")

      form#formRegistro(style="display: flex; flex-direction: column; gap: 15px;")
        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") Nombre (Solo letras, máx. 15)
          input#nombre(type="text" name="nombre" placeholder="Ej. Juan" maxlength="15" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;")
        </div>

        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") Apellido (Solo letras, máx. 15)
          input#apellido(type="text" name="apellido" placeholder="Ej. Pérez" maxlength="15" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;")
        </div>

        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") DNI (7 u 8 dígitos numéricos)
          input#dni(type="text" name="dni" placeholder="Ej. 35123456" maxlength="8" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;")
        </div>

        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") Correo Electrónico
          input#correo(type="email" name="correo" placeholder="correo@ejemplo.com" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;")
        </div>

        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") Fecha de Cumpleaños (+18 años)
          input#cumpleanos(type="date" name="cumpleaños" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;")
        </div>

        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") Nombre de Usuario (Username)
          input#username(type="text" name="username" placeholder="juanperez" maxlength="30" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;")
        </div>

        <div>
          label(style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 5px;") Contraseña
          input#password(type="password" name="password" placeholder="••••••••" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;")
        </div>

        <button type="submit" style="background: #2563eb; color: white; border: none; padding: 12px; border-radius: 6px; font-weight: bold; font-size: 15px; cursor: pointer; margin-top: 10px; width: 100%;">Registrarse</button>
      </form>

      <div style="text-align: center; margin-top: 20px; font-size: 14px;">
        <span style="color: #64748b;">¿Ya tienes una cuenta? </span>
        <a href="/auth/login" style="color: #2563eb; text-decoration: none; font-weight: bold;">Iniciar Sesión</a>
      </div>
    </div>

    script.
      // Función estricta para bloquear números y caracteres especiales en Nombre y Apellido
      const aplicarFiltroLetras = (inputElement) => {
        inputElement.addEventListener("input", (e) => {
          let valorLimpio = e.target.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ\s]/g, "");
          if (valorLimpio.length > 15) {
            valorLimpio = valorLimpio.slice(0, 15);
          }
          e.target.value = valorLimpio;
        });
      };

      aplicarFiltroLetras(document.getElementById("nombre"));
      aplicarFiltroLetras(document.getElementById("apellido"));

      // Función estricta para bloquear letras en el DNI
      const dniInput = document.getElementById("dni");
      dniInput.addEventListener("input", (e) => {
        let valorLimpio = e.target.value.replace(/\D/g, "");
        if (valorLimpio.length > 8) {
          valorLimpio = valorLimpio.slice(0, 8);
        }
        e.target.value = valorLimpio;
      });

      document.getElementById("formRegistro").addEventListener("submit", async (e) => {
        e.preventDefault();
        const alerta = document.getElementById("mensajeAlerta");
        alerta.style.display = "none";

        const nombre = document.getElementById("nombre").value.trim();
        const apellido = document.getElementById("apellido").value.trim();
        const dni = document.getElementById("dni").value.trim();
        const correo = document.getElementById("correo").value.trim();
        const cumpleaños = document.getElementById("cumpleanos").value;
        const username = document.getElementById("username").value.trim();
        const password = document.getElementById("password").value;

        const soloLetrasRegex = /^[A-Za-zÁÉÍÓÚáéíóúÑñ\s]+$/;
        if (!soloLetrasRegex.test(nombre) || !soloLetrasRegex.test(apellido)) {
          alerta.style.display = "block";
          alerta.style.background = "#fee2e2";
          alerta.style.color = "#991b1b";
          alerta.textContent = "⚠️ El nombre y el apellido deben contener únicamente letras.";
          return;
        }

        const dniRegex = /^\d{7,8}$/;
        if (!dniRegex.test(dni)) {
          alerta.style.display = "block";
          alerta.style.background = "#fee2e2";
          alerta.style.color = "#991b1b";
          alerta.textContent = "⚠️ El DNI debe ser numérico y tener entre 7 y 8 dígitos.";
          return;
        }

        const datos = { nombre, apellido, dni, correo, cumpleaños, username, password };

        try {
          const res = await fetch("/auth/registro", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(datos)
          });
          const resultado = await res.json();

          alerta.style.display = "block";
          if (!res.ok) {
            alerta.style.background = "#fee2e2";
            alerta.style.color = "#991b1b";
            alerta.textContent = resultado.error || "⚠️ Error al registrarse.";
          } else {
            alerta.style.background = "#d1e7dd";
            alerta.style.color = "#0f5132";
            alerta.textContent = "✅ ¡Registro exitoso! Redirigiendo...";
            setTimeout(() => { window.location.href = resultado.redirectUrl || "/auth/login"; }, 1500);
          }
        } catch (err) {
          alerta.style.display = "block";
          alerta.style.background = "#fee2e2";
          alerta.style.color = "#991b1b";
          alerta.textContent = "❌ Error al conectar con el servidor.";
        }
      });