doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Registro de Usuario
  body(style="font-family: sans-serif; max-width: 500px; margin: 30px auto;")
    h2 Registro de Usuario
    
    if error
      div(style="background-color: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 15px; border-radius: 4px; border: 1px solid #f5c6cb;")
        strong ⚠️ Error: 
        = error

    form(action="/auth/registro" method="POST")
      div(style="margin-bottom: 10px;")
        label(for="nombreUsuario") Nombre de Usuario:
        input#nombreUsuario(type="text" name="nombreUsuario" value=(datos ? datos.nombreUsuario : '') required style="width: 100%; padding: 6px;")

      div(style="margin-bottom: 10px;")
        label(for="nombre") Nombre:
        input#nombre(type="text" name="nombre" value=(datos ? datos.nombre : '') required style="width: 100%; padding: 6px;" onkeypress="return event.charCode < 48 || event.charCode > 57")
        
      div(style="margin-bottom: 10px;")
        label(for="apellido") Apellido:
        input#apellido(type="text" name="apellido" value=(datos ? datos.apellido : '') required style="width: 100%; padding: 6px;" onkeypress="return event.charCode < 48 || event.charCode > 57")
        
      div(style="margin-bottom: 10px;")
        label(for="email") Email:
        input#email(type="email" name="email" value=(datos ? datos.email : '') required style="width: 100%; padding: 6px;" placeholder="correo@ejemplo.com")
        
      div(style="margin-bottom: 10px;")
        label(for="password") Contraseña:
        input#password(type="password" name="password" required style="width: 100%; padding: 6px;")
        
      div(style="margin-bottom: 10px;")
        label(for="dni") DNI:
        input#dni(type="text" name="dni" value=(datos ? datos.dni : '') required maxlength="8" style="width: 100%; padding: 6px;" placeholder="Ej: 12345678" onkeypress="return event.charCode >= 48 && event.charCode <= 57")
        
      div(style="margin-bottom: 10px;")
        label(for="fechaNacimiento") Fecha de Nacimiento:
        input#fechaNacimiento(type="date" name="fechaNacimiento" value=(datos ? datos.fechaNacimiento : '') required style="width: 100%; padding: 6px;")
        
      div(style="margin-bottom: 10px;")
        label(for="telefono") Teléfono:
        input#telefono(type="tel" name="telefono" value=(datos ? datos.telefono : '') required pattern="[0-9]{10}" maxlength="10" style="width: 100%; padding: 6px;" placeholder="Ej: 1123456789" onkeypress="return event.charCode >= 48 && event.charCode <= 57")

      div(style="margin-bottom: 15px;")
        label(for="tipoCliente") Tipo de Cliente:
        select#tipoCliente(name="tipoCliente" style="width: 100%; padding: 6px; margin-top: 5px;")
          option(value="ESTANDAR" selected=(datos && datos.tipoCliente === 'ESTANDAR')) Estándar
          option(value="PREMIUM" selected=(datos && datos.tipoCliente === 'PREMIUM')) Premium
          option(value="VIP" selected=(datos && datos.tipoCliente === 'VIP')) VIP

      div
        button(type="submit" style="width: 100%; padding: 10px; background-color: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer;") Registrarse
      
      p(style="margin-top: 15px;") ¿Ya tienes cuenta? 
        a(href="/auth/login") Inicia sesión aquí