doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Editar Evento
    style
      include salas.css
  body
    header.card.header
      h1 ✏️ Editar Evento
      a.button(href="/eventos") ⬅️ Volver a Eventos
    main.card
      h2= evento.nombre
      if error
        .alert(role="alert")= error
      form(action=`/eventos/editar/${evento._id}` method="POST")
        .fields
          .field
            label(for="nombre") Nombre del Evento
            input#nombre(type="text" name="nombre" value=evento.nombre required)
          
          .field
            label(for="nombreEntidadSelect") Artista / Compañía / Productora
            select#nombreEntidadSelect(name="nombreEntidadSelect" onchange="toggleNuevoArtista(this)")
              option(value="") Seleccionar de la lista...
              if entidades
                each ent in entidades
                  option(value=ent.nombre selected=(evento.entidad && String(evento.entidad.nombre || evento.entidad) === String(ent.nombre)))= ent.nombre
              option(value="OTRO_NUEVO") ➕ Escribir uno nuevo...

            input#nombreEntidadTexto(type="text" name="nombreEntidadTexto" placeholder="Escribe el nombre del nuevo artista/compañía..." style="display:none; margin-top: 8px;" autocomplete="off")
                  
          .field
            label(for="fecha") Fecha
            - const fechaFormateada = evento.fecha ? (evento.fecha instanceof Date ? evento.fecha.toISOString().split('T')[0] : String(evento.fecha).slice(0, 10)) : ''
            input#fecha(type="date" name="fecha" value=fechaFormateada required)
          
          .field
            label(for="hora") Hora
            input#hora(type="time" name="hora" value=evento.hora required)
          
          .field
            label(for="sala") Sala
            select#sala(name="sala" required)
              option(value="") Seleccionar sala
              each sala in salas
                option(value=sala._id selected=(String((evento.sala && evento.sala._id) || evento.sala || "") === String(sala._id))) #{sala.nombre} (#{sala.capacidad} personas)
          
          .field
            label(for="entradasDisponibles") Entradas Disponibles
            input#entradasDisponibles(type="number" name="entradasDisponibles" min="0" step="1" value=evento.entradasDisponibles required)
          
          .field.wide
            label(for="descripcion") Descripción
            textarea#descripcion(name="descripcion" rows="3" required)= evento.descripcion
        .actions
          button.button(type="submit") Guardar Cambios
          a.button.secondary(href="/eventos") Cancelar

    script.
      function toggleNuevoArtista(select) {
        const inputTexto = document.getElementById('nombreEntidadTexto');
        if (select.value === 'OTRO_NUEVO') {
          inputTexto.style.display = 'block';
          inputTexto.required = true;
          inputTexto.focus();
          select.removeAttribute('name');
          select.required = false;
        } else {
          inputTexto.style.display = 'none';
          inputTexto.required = false;
          inputTexto.value = '';
          select.setAttribute('name', 'nombreEntidadSelect');
          select.required = true;
        }
      }