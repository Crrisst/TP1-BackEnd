doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Editar Usuario
  body
    nav
      a(href="/usuarios")
        button(type="button") Volver a Gestión de Usuarios
    hr

    if error
      div(style="background-color: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #f5c6cb;")
        strong ¡Error de validación! 
        span= error

    h1 Editar Usuario: #{usuario.nombreUsuario}

    form(action="/usuarios/" + usuario.id + "/editar" method="POST")
      div
        label(for="nombreUsuario") Nombre de Usuario:
        input#nombreUsuario(type="text" name="nombreUsuario" value=usuario.nombreUsuario required)
      div
        label(for="nombre") Nombre Real:
        input#nombre(type="text" name="nombre" value=usuario.nombre required)
      div
        label(for="apellido") Apellido:
        input#apellido(type="text" name="apellido" value=usuario.apellido required)
      div
        label(for="email") Email:
        input#email(type="email" name="email" value=usuario.email required)
      div
        label(for="password") Contraseña nueva (o repita la actual):
        input#password(type="password" name="password" required)
      div
        label(for="dni") DNI:
        input#dni(type="number" name="dni" value=usuario.dni required)
      div
        label(for="fechaNacimiento") Fecha de Nacimiento:
        input#fechaNacimiento(type="date" name="fechaNacimiento" value=usuario.fechaNacimiento required)
      div
        label(for="telefono") Teléfono:
        input#telefono(type="number" name="telefono" value=usuario.telefono required)
      div
        label(for="rol") Rol:
        select#rol(name="rol" required)
          //- Selecciona automáticamente el rol actual del usuario
          option(value="CLIENTE" selected=(usuario.rol === 'Cliente')) Cliente
          option(value="ADMINISTRADOR" selected=(usuario.rol === 'Administrador')) Administrador
      div
        button(type="submit") Guardar Cambios