doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Gestión de Eventos - Administración
    style
      include eventos.css
  body
    header.card.header
      h1 🎭 Gestión de Eventos
      nav.navigation(aria-label="Navegación de administración")
        a.button(href="/admin/dashboard") ⬅️ Volver al Panel
    main
      section.card(aria-labelledby="crear-evento")
        h2#crear-evento Cargar Nuevo Evento
        if error
          .alert= error
        form(action="/eventos" method="POST")
          .fields
            .field
              label(for="nombre") Nombre del Evento
              input#nombre(type="text" name="nombre" required)
            
            .field
              label(for="nombreEntidadSelect") Artista / Compañía / Productora
              select#nombreEntidadSelect(name="nombreEntidadSelect" onchange="toggleNuevoArtista(this)")
                option(value="") Seleccionar de la lista...
                if entidades
                  each ent in entidades
                    option(value=ent.nombre)= ent.nombre
                option(value="OTRO_NUEVO") ➕ Escribir uno nuevo...

              input#nombreEntidadTexto(type="text" name="nombreEntidadTexto" placeholder="Escribe el nombre del nuevo artista/compañía..." style="display:none; margin-top: 8px;" autocomplete="off")
            
            .field
              label(for="sala") Sala
              select#sala(name="sala" required)
                option(value="") Seleccionar sala
                each sala in salas
                  option(value=sala._id) #{sala.nombre} - Capacidad: #{sala.capacidad}
            
            .field
              label(for="fecha") Fecha
              input#fecha(type="date" name="fecha" required)
            
            .field
              label(for="hora") Hora
              input#hora(type="time" name="hora" required)
            
            .field
              label(for="precio") Precio
              input#precio(type="number" name="precio" min="0" step="1" value="5000" required)
            
            .field
              label(for="entradasDisponibles") Entradas disponibles
              input#entradasDisponibles(type="number" name="entradasDisponibles" min="0" step="1" required)
            
            .field.wide
              label(for="descripcion") Descripción
              textarea#descripcion(name="descripcion" rows="3" required)
          p La cantidad de entradas disponibles no puede superar la capacidad de la sala.
          button.button(type="submit") ➕ Cargar Evento

      section.card(aria-labelledby="listado-eventos")
        h2#listado-eventos Listado de Eventos
        if eventos && eventos.length > 0
          .table-container
            table
              thead
                tr
                  th Evento
                  th Presenta
                  th Descripción
                  th Sala
                  th Fecha
                  th Hora
                  th Precio
                  th Entradas
                  th Acciones
              tbody
                each evento in eventos
                  - const fechaFormateada = evento.fecha ? new Date(evento.fecha).toLocaleDateString('es-AR', { timeZone: 'UTC' }) : '-'
                  tr
                    td.name= evento.nombre
                    td(style="font-weight: bold; color: #0284c7;")= evento.entidad ? evento.entidad.nombre : '-'
                    td= evento.descripcion
                    td= evento.sala ? evento.sala.nombre : 'Sin sala'
                    td= fechaFormateada
                    td= evento.hora || '-'
                    td $#{Number(evento.precio || 0).toLocaleString('es-AR')}
                    td= evento.entradasDisponibles
                    td
                      .actions
                        a.button.edit(href=`/eventos/${evento.id}/editar`) ✏️ Editar
                        form(action=`/eventos/${evento.id}/delete` method="POST")
                          button.button.delete(type="submit" onclick="return confirm('¿Estás seguro?');") 🗑️ Eliminar
        else
          p.empty No hay eventos registrados.

    script.
      function toggleNuevoArtista(select) {
        const inputTexto = document.getElementById('nombreEntidadTexto');
        if (select.value === 'OTRO_NUEVO') {
          inputTexto.style.display = 'block';
          inputTexto.required = true;
          inputTexto.focus();
          select.required = false;
        } else {
          inputTexto.style.display = 'none';
          inputTexto.required = false;
          inputTexto.value = '';
          select.required = true;
        }
      }