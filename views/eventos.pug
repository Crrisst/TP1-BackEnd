doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Gestión de Eventos - Administración
    style
      include eventos.css
  body
    header.card.header
      h1 🎭 Gestión de Eventos
      nav.navigation(aria-label="Navegación de administración")
        a.button(href="/admin/dashboard") ⬅️ Volver al Panel
    main
      if error
        .alert= error
      if exito
        div(style="background-color: #d1e7dd; color: #0f5132; padding: 12px; border-radius: 6px; margin-bottom: 20px; border: 1px solid #badbcc; font-weight: bold;")= exito

      section.card(aria-labelledby="crear-evento")
        h2#crear-evento Cargar Nuevo Evento
        form(action="/eventos" method="POST")
          .fields
            .field
              label(for="nombre") Nombre del Evento
              input#nombre(type="text" name="nombre" required)
            
            .field
              label(for="nombreEntidadSelect") Artista / Compañía / Productora
              select#nombreEntidadSelect(name="nombreEntidadSelect" onchange="toggleNuevoArtista(this)")
                option(value="") Seleccionar de la lista...
                if entidades
                  each ent in entidades
                    option(value=ent.nombre)= ent.nombre
                option(value="OTRO_NUEVO") ➕ Escribir uno nuevo...

              input#nombreEntidadTexto(type="text" name="nombreEntidadTexto" placeholder="Escribe el nombre del nuevo artista/compañía..." style="display:none; margin-top: 8px; margin-bottom: 4px;" autocomplete="off")
              
              //- 🟢 BOTÓN DESPLEGABLE UBICADO EXACTAMENTE DONDE INDICASTE (ÁREA ROSA)
              div(style="margin-top: 6px;")
                button(type="button" onclick="togglePanelArtistas()" style="background: none; border: none; color: #0284c7; padding: 0; font-size: 13px; font-weight: bold; cursor: pointer; text-decoration: underline;") ✏️ Administrar / Editar artistas existentes
            
            //- 🟢 CONTENEDOR DESPLEGABLE (ACORDEÓN) PARA GESTIONAR ARTISTAS
            .field.wide#panelAdministrarArtistas(style="display: none; background: #f8fafc; border: 1px solid #e2e8f0; padding: 15px; border-radius: 6px; margin-top: 5px;")
              h3(style="margin: 0 0 8px 0; font-size: 15px; color: #1e293b;") 📋 Listado de Artistas / Compañías Registradas
              p(style="color: #64748b; font-size: 12px; margin-bottom: 12px; line-height: 1.4;") Si te equivocaste al tipear un nombre, edítalo aquí. Se actualizará automáticamente en todos los eventos asociados.
              
              if entidades && entidades.length > 0
                div(style="max-height: 200px; overflow-y: auto; border: 1px solid #cbd5e1; border-radius: 4px; background: white;")
                  table(style="width: 100%; border-collapse: collapse; font-size: 12px;")
                    tbody
                      each ent in entidades
                        tr(style="border-bottom: 1px solid #f1f5f9;")
                          td(style="padding: 8px;")
                            form(action=`/eventos/entidades/${ent._id}/editar` method="POST" style="display: flex; gap: 8px; margin: 0;" id=`form-ent-${ent._id}`)
                              input(type="text" name="nombre" value=ent.nombre required style="padding: 5px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 12px; width: 100%;")
                          td(style="padding: 8px; text-align: right; width: 140px; white-space: nowrap;")
                            button.button.edit(type="submit" form=`form-ent-${ent._id}` style="padding: 4px 8px; font-size: 11px;") 💾 Guardar
                            |  
                            a.button.delete(href=`/eventos/entidades/${ent._id}/delete` onclick="return confirm('¿Estás seguro de eliminar este artista?');" style="padding: 4px 8px; font-size: 11px; text-decoration: none;") 🗑️
              else
                p(style="color: #64748b; font-size: 12px; font-style: italic; margin: 0;") No hay artistas registrados.

            .field
              label(for="sala") Sala
              select#sala(name="sala" required)
                option(value="") Seleccionar sala
                each sala in salas
                  option(value=sala._id) #{sala.nombre} - Capacidad: #{sala.capacidad}
            
            .field
              label(for="fecha") Fecha
              input#fecha(type="date" name="fecha" required)
            
            .field
              label(for="hora") Hora
              input#hora(type="time" name="hora" required)
            
            .field
              label(for="precio") Precio
              input#precio(type="number" name="precio" min="0" step="1" value="5000" required)
            
            .field
              label(for="entradasDisponibles") Entradas disponibles
              input#entradasDisponibles(type="number" name="entradasDisponibles" min="0" step="1" required)
            
            .field.wide
              label(for="descripcion") Descripción
              textarea#descripcion(name="descripcion" rows="3" required)
          p La cantidad de entradas disponibles no puede superar la capacidad de la sala.
          button.button(type="submit") ➕ Cargar Evento

      section.card(aria-labelledby="listado-eventos")
        h2#listado-eventos Listado de Eventos
        if eventos && eventos.length > 0
          .table-container
            table
              thead
                tr
                  th Evento
                  th Presenta
                  th Descripción
                  th Sala
                  th Fecha
                  th Hora
                  th Precio
                  th Entradas
                  th Acciones
              tbody
                each evento in eventos
                  - const fechaFormateada = evento.fecha ? new Date(evento.fecha).toLocaleDateString('es-AR', { timeZone: 'UTC' }) : '-'
                  tr
                    td.name= evento.nombre
                    td(style="font-weight: bold; color: #0284c7;")= evento.entidad ? evento.entidad.nombre : '-'
                    td= evento.descripcion
                    td= evento.sala ? evento.sala.nombre : 'Sin sala'
                    td= fechaFormateada
                    td= evento.hora || '-'
                    td $#{Number(evento.precio || 0).toLocaleString('es-AR')}
                    td= evento.entradasDisponibles
                    td
                      .actions
                        a.button.edit(href=`/eventos/${evento._id}/editar`) ✏️ Editar
                        form(action=`/eventos/${evento._id}/delete` method="POST")
                          button.button.delete(type="submit" onclick="return confirm('¿Estás seguro?');") 🗑️ Eliminar
        else
          p.empty No hay eventos registrados.

    script.
      function toggleNuevoArtista(select) {
        const inputTexto = document.getElementById('nombreEntidadTexto');
        if (select.value === 'OTRO_NUEVO') {
          inputTexto.style.display = 'block';
          inputTexto.required = true;
          inputTexto.focus();
          select.removeAttribute('name');
          select.required = false;
        } else {
          inputTexto.style.display = 'none';
          inputTexto.required = false;
          inputTexto.value = '';
          select.setAttribute('name', 'nombreEntidadSelect');
          select.required = true;
        }
      }

      // 🟢 Función para abrir/cerrar el panel desplegable de gestión de artistas
      function togglePanelArtistas() {
        const panel = document.getElementById('panelAdministrarArtistas');
        if (panel.style.display === 'none' || panel.style.display === '') {
          panel.style.display = 'block';
        } else {
          panel.style.display = 'none';
        }
      }