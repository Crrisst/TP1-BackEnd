doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Gestión de Salas - Administración
    style
      include salas.css
  body
    header.card.header
      h1 🏢 Gestión de Salas
      nav.navigation(aria-label="Navegación de administración")
        a.button(href="/admin/dashboard") ⬅️ Volver al Panel

    main
      section.card(aria-labelledby="crear-sala")
        h2#crear-sala Cargar Nueva Sala
        form(action="/salas" method="POST")
          .fields
            .field
              label(for="nombre") Nombre
              input#nombre(type="text" name="nombre" required)
            each zona in ['General', 'Platea', 'VIP']
              .field
                label(for=`capacidad-${zona}`) Capacidad sector #{zona.toLowerCase()}
                input(id=`capacidad-${zona}` type="number" name=`zonas[${zona}]` min="0" step="1" required)
            .field.wide
              label(for="descripcion") Descripción
              textarea#descripcion(name="descripcion" rows="3")
          p La capacidad total se calcula sumando General, Platea y VIP. Usá 0 si una zona no está habilitada.
          button.button(type="submit") ➕ Cargar Sala

      section.card(aria-labelledby="listado-salas")
        h2#listado-salas Listado de Salas
        if salas && salas.length > 0
          .table-container
            table
              thead
                tr
                  th(scope="col") Nombre
                  th(scope="col") Descripción
                  th(scope="col") General
                  th(scope="col") Platea
                  th(scope="col") VIP
                  th(scope="col") Capacidad total
                  th(scope="col") Acciones
              tbody
                each sala in salas
                  tr
                    td.name= sala.nombre
                    td= sala.descripcion || 'Sin descripción'
                    td= sala.zonas.General
                    td= sala.zonas.Platea
                    td= sala.zonas.VIP
                    td= sala.capacidad
                    td
                      .actions
                        a.button.edit(href=`/salas/${sala.id}/editar` aria-label=`Editar sala ${sala.nombre}`) ✏️ Editar
                        form(action=`/salas/${sala.id}/delete` method="POST")
                          button.button.delete(type="submit" aria-label=`Eliminar sala ${sala.nombre}` onclick="return confirm('¿Estás seguro de eliminar esta sala?');") 🗑️ Eliminar
        else
          p.empty No hay salas registradas en el sistema.
